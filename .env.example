# Copy to config.properties (classpath) for local dev, or export as env vars in deployment.
# Never commit the filled-in version — config.properties is gitignored.

# --- Database (H2) ---
DB_URL=jdbc:h2:tcp://localhost:9092/./data/adharshmart
DB_USERNAME=sa
DB_PASSWORD=
DB_POOL_SIZE=10

# --- AI chatbot (Section 11/17) ---
# provider: mock (default, no network/API key needed) | gemini
AI_CHATBOT_PROVIDER=mock
AI_CHATBOT_APIKEY=
AI_CHATBOT_MODEL=gemini-1.5-flash
AI_CHATBOT_TIMEOUTSECONDS=8
