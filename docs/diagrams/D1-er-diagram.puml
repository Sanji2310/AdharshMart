@startuml D1-ER-Diagram
title AdharshMart — Entity Relationship Diagram (Section 4 schema)

entity "users" as users {
  * id : BIGINT <<PK>>
  --
  name : VARCHAR(120)
  * email : VARCHAR(190) <<UNIQUE>>
  password_hash : VARCHAR(60)
  role : ENUM('BUYER','SELLER','ADMIN')
  created_at : TIMESTAMP
}

entity "products" as products {
  * id : BIGINT <<PK>>
  --
  * seller_id : BIGINT <<FK users.id>>
  name : VARCHAR(160)
  description : VARCHAR(2000)
  price : DECIMAL(10,2)
  stock_qty : INT
  category : VARCHAR(80)
  image_url : VARCHAR(500)
  active : BOOLEAN
  created_at : TIMESTAMP
}

entity "orders" as orders {
  * id : BIGINT <<PK>>
  --
  * buyer_id : BIGINT <<FK users.id>>
  status : ENUM('PENDING','CONFIRMED','SHIPPED','DELIVERED','CANCELLED')
  total_amount : DECIMAL(10,2)
  created_at : TIMESTAMP
}

entity "order_items" as order_items {
  * id : BIGINT <<PK>>
  --
  * order_id : BIGINT <<FK orders.id>>
  * product_id : BIGINT <<FK products.id>>
  quantity : INT
  unit_price : DECIMAL(10,2)
  created_at : TIMESTAMP
}

entity "cart_items" as cart_items {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK users.id>>
  * product_id : BIGINT <<FK products.id>>
  quantity : INT
  created_at : TIMESTAMP
}

entity "reviews" as reviews {
  * id : BIGINT <<PK>>
  --
  * product_id : BIGINT <<FK products.id>>
  * user_id : BIGINT <<FK users.id>>
  rating : INT
  comment : VARCHAR(1000)
  created_at : TIMESTAMP
}

users ||--o{ products : "sells (seller_id)"
users ||--o{ orders : "places (buyer_id)"
users ||--o{ cart_items : "owns (user_id)"
users ||--o{ reviews : "writes (user_id)"
orders ||--o{ order_items : "contains"
products ||--o{ order_items : "ordered as"
products ||--o{ cart_items : "added as"
products ||--o{ reviews : "rated by"

@enduml
